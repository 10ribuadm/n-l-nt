<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Segera Hadir — Nurul Muttaqin</title>
<meta name="description" content="Galeri dokumentasi Lembaga Nurul Muttaqin segera hadir.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0A2C2A;
    --ivory:#F6F1E4;
    --teal-deep:#0E3B39;
    --teal-mid:#175A54;
    --gold:#C7972B;
    --gold-soft:#E8C77A;
    --line: rgba(246,241,228,0.16);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{ height:100%; }
  body{
    font-family:'Plus Jakarta Sans', sans-serif;
    color:var(--ivory);
    background:
      radial-gradient(120% 140% at 12% -10%, #1C6B62 0%, var(--teal-deep) 45%, #071F1E 100%);
    min-height:100vh;
    display:flex; flex-direction:column;
    overflow-x:hidden;
    position:relative;
  }
  a{ color:inherit; }

  /* ---------- animated star field ---------- */
  .stars{
    position:fixed; inset:0; z-index:0; pointer-events:none; opacity:0.5;
  }
  .stars span{
    position:absolute; width:3px; height:3px; background:var(--gold-soft);
    border-radius:50%; opacity:0.5;
    animation: twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle{
    0%, 100%{ opacity:0.15; transform:scale(0.8); }
    50%{ opacity:0.85; transform:scale(1.3); }
  }

  .glow{
    position:fixed; width:600px; height:600px; border-radius:50%;
    background:radial-gradient(circle, rgba(199,151,43,0.28), transparent 70%);
    top:-160px; right:-160px; filter:blur(6px); z-index:0; pointer-events:none;
  }
  .glow.two{
    top:auto; right:auto; bottom:-200px; left:-200px;
    background:radial-gradient(circle, rgba(23,90,84,0.5), transparent 70%);
  }

  /* ---------- geometric star mark (signature) ---------- */
  .mark-wrap{
    position:relative; width:104px; height:104px; margin:0 auto 34px;
  }
  .mark-wrap svg{
    width:100%; height:100%;
    animation: spin 40s linear infinite;
    filter: drop-shadow(0 0 22px rgba(199,151,43,0.45));
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  .mark-wrap::after{
    content:""; position:absolute; inset:14px; border-radius:50%;
    border:1px solid rgba(232,199,122,0.35);
  }

  main{
    position:relative; z-index:2;
    flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:60px 24px;
  }

  .eyebrow{
    display:inline-flex; align-items:center; gap:10px;
    font-size:0.72rem; letter-spacing:0.2em; text-transform:uppercase;
    font-weight:700; color:var(--gold-soft); margin-bottom:22px;
  }
  .eyebrow::before, .eyebrow::after{ content:""; width:22px; height:1px; background:var(--gold-soft); }

  h1{
    font-family:'Amiri', serif; font-weight:700;
    font-size:clamp(2.4rem, 6vw, 4.2rem); line-height:1.1;
    max-width:820px;
  }
  h1 em{ font-style:italic; color:var(--gold-soft); }

  .subtitle{
    margin:22px 0 46px; max-width:520px;
    color:rgba(246,241,228,0.72); font-size:1.05rem; line-height:1.7;
  }

  /* ---------- countdown ---------- */
  .countdown{
    display:flex; gap:14px; flex-wrap:wrap; justify-content:center; margin-bottom:46px;
  }
  .cd-item{
    width:96px; padding:18px 0 14px; border-radius:16px;
    background:rgba(246,241,228,0.06);
    border:1px solid var(--line);
    backdrop-filter:blur(6px);
    position:relative; overflow:hidden;
  }
  .cd-item::before{
    content:""; position:absolute; top:0; left:0; right:0; height:1px;
    background:linear-gradient(90deg, transparent, var(--gold-soft), transparent);
  }
  .cd-num{
    font-family:'Amiri', serif; font-weight:700; font-size:2.1rem; color:var(--ivory);
    font-variant-numeric: tabular-nums;
  }
  .cd-label{
    margin-top:6px; font-size:0.65rem; letter-spacing:0.14em; text-transform:uppercase;
    color:rgba(246,241,228,0.55); font-weight:600;
  }

  /* ---------- notify form ---------- */
  .notify{
    display:flex; gap:10px; flex-wrap:wrap; justify-content:center; width:100%; max-width:440px;
  }
  .notify input{
    flex:1; min-width:200px;
    padding:15px 20px; border-radius:999px; border:1px solid var(--line);
    background:rgba(246,241,228,0.06); color:var(--ivory); font-size:0.92rem;
    font-family:inherit; outline:none; transition:.25s ease;
  }
  .notify input::placeholder{ color:rgba(246,241,228,0.45); }
  .notify input:focus{ border-color:var(--gold-soft); background:rgba(246,241,228,0.1); }
  .notify button{
    padding:15px 26px; border-radius:999px; border:none; cursor:pointer;
    background:var(--gold); color:var(--teal-deep); font-weight:700; font-size:0.92rem;
    font-family:inherit; display:inline-flex; align-items:center; gap:8px;
    transition:transform .25s ease, box-shadow .25s ease;
    box-shadow:0 14px 26px -12px rgba(199,151,43,0.55);
  }
  .notify button:hover{ transform:translateY(-2px); }
  .notify button:active{ transform:translateY(0); }

  .form-msg{
    margin-top:16px; font-size:0.85rem; color:var(--gold-soft);
    height:18px; opacity:0; transition:opacity .3s ease;
  }
  .form-msg.show{ opacity:1; }

  /* ---------- socials ---------- */
  .socials{
    position:relative; z-index:2;
    display:flex; justify-content:center; gap:14px; padding:0 24px 40px;
  }
  .socials a{
    width:42px; height:42px; border-radius:50%; border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    transition:.25s ease;
  }
  .socials a:hover{ background:var(--gold); border-color:var(--gold); color:var(--teal-deep); transform:translateY(-3px); }

  footer{
    position:relative; z-index:2;
    text-align:center; padding:0 24px 30px;
    font-size:0.78rem; color:rgba(246,241,228,0.45);
  }
  footer span{ color:var(--gold-soft); }

  @media (max-width:480px){
    .cd-item{ width:76px; padding:14px 0 10px; }
    .cd-num{ font-size:1.6rem; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }
</style>
</head>
<body>

<div class="glow"></div>
<div class="glow two"></div>
<div class="stars" id="stars"></div>

<main>
  <div class="mark-wrap">
    <svg viewBox="0 0 100 100" fill="none">
      <path d="M50 2 L61 32 L92 22 L70 46 L98 50 L70 54 L92 78 L61 68 L50 98 L39 68 L8 78 L30 54 L2 50 L30 46 L8 22 L39 32 Z"
        stroke="#E8C77A" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
  </div>

  <span class="eyebrow">Nurul Muttaqin</span>
  <h1>Galeri Kami <em>Segera Hadir</em></h1>
  <p class="subtitle">
    Kami sedang menyiapkan galeri foto &amp; video dokumentasi kegiatan Lembaga Nurul Muttaqin.
    Nantikan peluncurannya sebentar lagi.
  </p>

  <div class="countdown" id="countdown">
    <div class="cd-item"><div class="cd-num" id="cd-days">00</div><div class="cd-label">Hari</div></div>
    <div class="cd-item"><div class="cd-num" id="cd-hours">00</div><div class="cd-label">Jam</div></div>
    <div class="cd-item"><div class="cd-num" id="cd-mins">00</div><div class="cd-label">Menit</div></div>
    <div class="cd-item"><div class="cd-num" id="cd-secs">00</div><div class="cd-label">Detik</div></div>
  </div>

  <form class="notify" id="notifyForm">
    <input type="email" id="notifyEmail" placeholder="Masukkan email Anda" required>
    <button type="submit">
      Beri Tahu Saya
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </form>
  <p class="form-msg" id="formMsg">Terima kasih, kami akan mengabari Anda saat galeri rilis.</p>
</main>

<div class="socials">
  <a href="#" aria-label="Instagram"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg></a>
  <a href="#" aria-label="YouTube"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="12" rx="4" stroke="currentColor" stroke-width="1.7"/><path d="M11 9.5l4 2.5-4 2.5v-5z" fill="currentColor"/></svg></a>
  <a href="https://wa.me/6285161707213" aria-label="WhatsApp" target="_blank" rel="noopener"><svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2z" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 8.7c.3-.6.6-.6.9-.6h.6c.2 0 .4 0 .6.5s.7 1.8.8 1.9.1.3 0 .5-.2.3-.4.5-.4.4-.5.6-.3.4 0 .8a6.3 6.3 0 002.8 2.5c.4.2.6.1.8-.1s.9-1 1.1-1.3.5-.3.8-.2 1.9.9 2.3 1.1.6.3.7.4a3 3 0 01-.2 1.6c-.2.5-1.2 1-1.7 1.1-.4.1-1 .1-1.6-.1a12 12 0 01-5.5-3.9 8 8 0 01-1.6-4.6c0-.7.2-1.3.5-1.7z" fill="currentColor"/></svg></a>
</div>

<footer>
  Jl. Sukasari, Dusun Wakan, Desa Wakan, Kec. Jerowaru, Kab. Lombok Timur, NTB &nbsp;·&nbsp;
  <span>&copy; <span id="year"></span> Nurul Muttaqin</span>
</footer>

<script>
document.getElementById('year').textContent = new Date().getFullYear();

/* Bintang acak beranimasi (tanpa gambar eksternal) */
const starsWrap = document.getElementById('stars');
const STAR_COUNT = 60;
for(let i=0;i<STAR_COUNT;i++){
  const s = document.createElement('span');
  s.style.left = Math.random()*100+'%';
  s.style.top = Math.random()*100+'%';
  s.style.animationDelay = (Math.random()*4)+'s';
  s.style.animationDuration = (3+Math.random()*3)+'s';
  const size = 1.5 + Math.random()*2.2;
  s.style.width = size+'px';
  s.style.height = size+'px';
  starsWrap.appendChild(s);
}

/* ============ Countdown ============ */
/* GANTI tanggal target peluncuran di bawah ini (format: 'YYYY-MM-DDTHH:mm:ss') */
const TARGET_DATE = new Date('2026-09-01T00:00:00+08:00').getTime();

function updateCountdown(){
  const now = Date.now();
  let diff = TARGET_DATE - now;
  if(diff < 0) diff = 0;

  const days = Math.floor(diff / (1000*60*60*24));
  const hours = Math.floor((diff / (1000*60*60)) % 24);
  const mins = Math.floor((diff / (1000*60)) % 60);
  const secs = Math.floor((diff / 1000) % 60);

  document.getElementById('cd-days').textContent = String(days).padStart(2,'0');
  document.getElementById('cd-hours').textContent = String(hours).padStart(2,'0');
  document.getElementById('cd-mins').textContent = String(mins).padStart(2,'0');
  document.getElementById('cd-secs').textContent = String(secs).padStart(2,'0');
}
updateCountdown();
setInterval(updateCountdown, 1000);

/* ============ Notify form (front-end only) ============ */
const form = document.getElementById('notifyForm');
const msg = document.getElementById('formMsg');
form.addEventListener('submit', (e)=>{
  e.preventDefault();
  const email = document.getElementById('notifyEmail').value.trim();
  if(!email) return;
  msg.classList.add('show');
  form.reset();
  /* TODO: sambungkan ke backend/Google Form/Mailchimp dsb untuk menyimpan email */
});
</script>
</body>
</html>
